# Token of the creator bot from @BotFather
BOT_TOKEN=

# Your Telegram ID (several admins: comma separated)
ADMIN_IDS=

MAIN_BOT_USERNAME=TitanVPS_bot
SUPPORT_CONTACT=@TitanVPS_SMM
TIMEZONE=Europe/Samara

# Own database of this bot
DB_PATH=/opt/creator_bot/creators.db

# Main bot database: opened read-only, nothing is written there
MAIN_DB_PATH=/root/bot/vpn_bot.db

# Optional: Remnawave read-only access to avoid paying twice for one device (HWID).
# Leave empty to skip this check.
REMNA_URL=
REMNA_TOKEN=

# Rules
MIN_PAYOUT=1000
# Minimum traffic (MB) for a connection to count
MIN_TRAFFIC_MB=5
# Days a new user has to connect (trial length)
QUALIFY_DAYS=3
CHECK_INTERVAL_SEC=300
